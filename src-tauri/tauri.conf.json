{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vault",
  "version": "0.2.0",
  "identifier": "com.user.vault-app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Vault",
        "url": "index.html",
        "width": 1000,
        "height": 700,
        "visible": true,
        "skipTaskbar": false,
        "decorations": false,
        "alwaysOnTop": false,
        "center": true,
        "focus": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
